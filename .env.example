# ===== 必填 =====
# MongoDB 连接串。本地用 docker-compose 时保持默认即可；
# 生产建议 MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/app_factory_seo
MONGODB_URI=mongodb://localhost:27017/app_factory_seo

# 种子关键词，逗号分隔（围绕你的产品痛点）
SEED_KEYWORDS=photo blur how to,fix blurry photo

# ===== 选填 =====
# 要搜索的 subreddit，逗号分隔
SUBREDDITS=iphone,photography

# 每个关键词在每个来源最多深入抓取的帖子数
MAX_POSTS_PER_KEYWORD=5

# 每个种子词最多取多少个联想词参与抓取
MAX_SUGGESTIONS_PER_SEED=20

# HTTP 代理（被封 IP 时配置住宅代理），形如 http://user:pass@host:port
PROXY_URL=

# 清洗后文本最短长度，低于此值丢弃
MIN_CONTENT_LENGTH=50
