# ===== 必填 =====
# MongoDB 连接串。本地用 docker-compose 时保持默认即可；
# 生产建议 MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/app_factory_seo
MONGODB_URI=mongodb://localhost:27017/app_factory_seo

# 种子关键词，逗号分隔（围绕你的产品痛点）
SEED_KEYWORDS=photo blur how to,fix blurry photo

# ===== 选填 =====
# 要搜索的 subreddit，逗号分隔
SUBREDDITS=iphone,photography

# 每个关键词在每个来源最多深入抓取的帖子数
MAX_POSTS_PER_KEYWORD=5

# 每个种子词最多取多少个联想词参与抓取
MAX_SUGGESTIONS_PER_SEED=20

# HTTP 代理（被封 IP 时配置住宅代理），形如 http://user:pass@host:port
PROXY_URL=

# 清洗后文本最短长度，低于此值丢弃
MIN_CONTENT_LENGTH=50

# ===== 分析模块（npm run analyze）=====
# DeepSeek API Key（必填，除非 MOCK_LLM=true）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# true 时不调真实 API，用规则打分模拟（测试用）
MOCK_LLM=false

# Serper.dev API Key（排名速度分 SERP 实测；留空自动降级为免费信号）
SERPER_API_KEY=
# true 时不调 Serper，用规则生成 SERP 信号（测试用）
MOCK_SERP=false

# 热度打分后送入 LLM 终审的候选簇数量
LLM_CANDIDATES=50
# 最终输出痛点数量
FINAL_TOP_N=10
# 总分权重：痛感/商业意图/排名速度/热度
# 新站期保持 rank_speed=0.2；站点权重起来后调回 0 再攻高难度词
WEIGHT_PAIN=0.4
WEIGHT_INTENT=0.25
WEIGHT_RANK_SPEED=0.2
WEIGHT_HEAT=0.15
